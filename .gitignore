*.log
.DS_Store
Thumbs.db
desktop.ini

# Local redirect file (specific to individual setups)
/index.php

# Environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# Composer lock and phar (lock often kept in apps; omit if desired)
composer.phar

# PHP Unit/Cache
.phpactor.json
.phpunit.result.cache
/.phpunit.cache

# IDE/editor
/.fleet
/.idea
/.nova
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/launch.json
!/.vscode/tasks.json
/.zed

# Node/Vite
/node_modules
/.vite
/public/hot
/public/build
/public/storage
/public/uploads/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel storage and bootstrap cache (keep placeholder .gitignore files)
/storage/*
!/storage/.gitignore
!/storage/app/.gitignore
!/storage/app/public/.gitignore
!/storage/framework/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Vendor
/vendor/

# Local DB dumps (keep migrations)
/database/*.sqlite
/database/*.sql
/database/*.mysql

# Homestead
Homestead.json
Homestead.yaml
